name: Deploy to npm

on:
  push:
    branches:
      - main  # or your default branch

jobs:
  build:
    name: Build, lint, test, and deploy npm package on Node ${{ matrix.node }} and ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        node: ['10.x', '12.x', '14.x']
        os: [ubuntu-latest, windows-latest, macOS-latest]

    steps:
    - name: Checkout code
      uses: actions/checkout@v2

    - name: Use Node.js
      uses: actions/setup-node@v2
      with:
        node-version: '14'
        registry-url: 'https://registry.npmjs.org'

    - name: Install dependencies
      run: yarn install

    - name: Lint
      run: yarn lint

    - name: Test
      run: yarn test --ci --coverage --maxWorkers=2

    - name: Build package
      run: yarn run build:prod  # or your build command

    - name: Run tests
      run: yarn test  # or your test command

    - name: Publish package
      run: yarn publish
      env:
        NODE_AUTH_TOKEN: ${{secrets.NPM_AUTH_TOKEN}}
