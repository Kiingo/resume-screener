{
  "version": "0.1.0",
  "name": "@kiingo/brain-common-ts-contracts",
  "description": "",
  "author": "Ross Hartmann",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/src/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/src/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "shx rm -rf ./dist && rollup -c --configPlugin @rollup/plugin-typescript",
    "build:dev": "cross-env NODE_ENV=development yarn run build",
    "build:prod": "cross-env NODE_ENV=production yarn run build",
    "relink-kiingo-packages": "shx rm -rf ./node_modules/@kiingo && rm -rf ./yarn.lock && yarn install",
    "test": "node --experimental-vm-modules ./node_modules/jest-cli/bin/jest.js --passWithNoTests --config ./jest.config.ts --detectOpenHandles --forceExit",
    "test-debug": "node --experimental-vm-modules ./node_modules/jest-cli/bin/jest.js --passWithNoTests --config ./jest.config.ts --runInBand --detectOpenHandles",
    "lint": "eslint . --ext .ts --config ./.eslintrc.cjs --ignore-path ./.eslintignore",
    "lint-fix": "eslint . --ext .ts --config ./.eslintrc.cjs --ignore-path ./.eslintignore --fix",
    "prettier-check": "prettier --config ./.prettierrc --ignore-path ./.prettierignore --check --debug-check .",
    "prettier-fix": "prettier --config ./.prettierrc --ignore-path ./.prettierignore --write .",
    "prepare": "yarn run build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "peerDependencies": {},
  "husky": {
    "hooks": {
      "pre-commit": "yarn run lint"
    }
  },
  "size-limit": [
    {
      "path": "dist/brain-common-ts-contracts.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/brain-common-ts-contracts.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@size-limit/preset-small-lib": "^9.0.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.2",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-filename-rules": "^1.3.1",
    "eslint-plugin-jest": "^27.4.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "javascript-obfuscator": "^4.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "rollup": "^3.29.2",
    "rollup-plugin-obfuscator": "^1.0.3",
    "rollup-plugin-typescript2": "^0.35.0",
    "shx": "^0.3.4",
    "size-limit": "^9.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "tsx": "^3.13.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {}
}
