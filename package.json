{
  "version": "0.1.0",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "tsdx test",
    "lint": "tsdx lint",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "peerDependencies": {},
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "endOfLine": "auto"
  },
  "name": "brain-common-ts-contracts",
  "author": "Ross Hartmann",
  "module": "dist/brain-common-ts-contracts.esm.js",
  "size-limit": [
    {
      "path": "dist/brain-common-ts-contracts.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/brain-common-ts-contracts.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^9.0.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint-plugin-filename-rules": "^1.3.1",
    "husky": "^8.0.3",
    "size-limit": "^9.0.0",
    "ts-node": "^10.9.1",
    "tsdx": "^0.14.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  }
}
